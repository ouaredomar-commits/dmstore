# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# DZMahall — Notifications de Nouvelles Commandes via Gmail SMTP (Côté Serveur)
# ============================================================================
# Utilise exclusivement le serveur SMTP officiel de Gmail (smtp.gmail.com).
# IMPORTANT : Gmail exige un « Mot de passe d'application Google » de 16 lettres
# généré sur https://myaccount.google.com/apppasswords (Validation en 2 étapes activée).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ouaredomar@gmail.com
SMTP_PASS=
SMTP_FROM="DZMahall <ouaredomar@gmail.com>"
